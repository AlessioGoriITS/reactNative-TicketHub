# Shared project settings
COMPOSE_PROJECT_NAME=tickethub

# PostgreSQL development configuration
POSTGRES_DB=tickethub
POSTGRES_USER=tickethub
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Backend configuration
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://tickethub:change-me-for-local-development@postgres:5432/tickethub
JWT_SECRET_KEY=replace-this-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api

# Local AI configuration. Docker Compose starts Ollama and downloads this model automatically.
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_PORT=11434
AI_TIMEOUT_SECONDS=120
